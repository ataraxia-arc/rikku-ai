# Safe public Supabase values. Obtain these from the Supabase project Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public application origin, for example http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only keys. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Base64-encoded 32-byte key. Generate once per environment and preserve it for decryption.
BITGET_CREDENTIAL_ENCRYPTION_KEY=
LLM_API_KEY=
